# Copy relevant lines into your own .env (gitignored, never committed).
# This file is safe to commit — placeholders only, no real credentials.

# --- Local dev Postgres (docker-compose.yml) ---
# Distinct from RDS_MASTER_USERNAME/RDS_MASTER_PASSWORD below — those are for the
# separate AWS RDS environment. Do not reuse RDS credentials here.
LOCAL_DB_USER=cba_dev
LOCAL_DB_PASSWORD=changeme_dev_only
LOCAL_DB_NAME=cba_rag_dev
LOCAL_DB_PORT=5432

# --- AWS RDS (production/deploy target, NOT used by docker-compose.yml) ---
RDS_MASTER_USERNAME=changeme
RDS_MASTER_PASSWORD=changeme
# The real instance's endpoint (aws rds describe-db-instances --db-instance-identifier
# south-st-pete-dev-db --query 'DBInstances[0].Endpoint.Address') — kept out of
# infra/register_app_taskdefs.sh (deploy-review pre-commit finding, DECISIONS #121)
# so pointing the deploy at a different instance is a config edit, not a script edit.
RDS_HOST=changeme.rds.amazonaws.com

# --- AWS Fargate networking (infra/run_migration_task.sh; api/worker services
# use the same values, currently still inline in infra/DEPLOY_NEXT_STEPS.md) ---
FARGATE_SUBNET_IDS=subnet-changeme1,subnet-changeme2,subnet-changeme3
FARGATE_SG_ID=sg-changeme

# --- OpenAI ---
OPENAI_API_KEY=sk-changeme

# --- Cost alerts (infra/register_cost_alerts.sh; AWS Budgets + SNS) ---
# Real email, never committed — this placeholder is what ships in the
# example. BUDGET_ALERT_EMAIL is the SNS topic's email subscription
# target; whoever owns it will get an AWS subscription-confirmation
# email that must be clicked before alerts actually deliver.
BUDGET_ALERT_EMAIL=changeme@example.com
# Monthly cost budget in whole USD, no currency symbol. Amber has not
# picked a figure yet as of this file's last edit — see this round's
# DECISIONS entry / deploy-infra report for 2-3 reasoned candidates.
# Deliberately not defaulted to a guessed number here (CLAUDE.md: don't
# invent a dollar figure on Amber's behalf).
MONTHLY_BUDGET_USD=changeme
