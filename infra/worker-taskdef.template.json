{
  "family": "south-st-pete-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::516887747774:role/south-st-pete-ecs-task-execution-role",
  "containerDefinitions": [
    {
      "name": "south-st-pete-worker",
      "image": "__IMAGE__",
      "essential": true,
      "command": ["sh", "-c", "python -m app.granicus.run_worker"],
      "environment": [
        {"name": "LOCAL_DB_HOST", "value": "__DB_HOST__"},
        {"name": "LOCAL_DB_USER", "value": "__RDS_MASTER_USERNAME__"},
        {"name": "LOCAL_DB_PASSWORD", "value": "__RDS_MASTER_PASSWORD__"},
        {"name": "LOCAL_DB_NAME", "value": "southstpete"},
        {"name": "LOCAL_DB_PORT", "value": "5432"},
        {"name": "OPENAI_API_KEY", "value": "__OPENAI_API_KEY__"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/south-st-pete-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "worker",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
