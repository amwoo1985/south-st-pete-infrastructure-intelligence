{
  "family": "south-st-pete-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/south-st-pete-ecs-task-execution-role",
  "taskRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/south-st-pete-api-task-role",
  "containerDefinitions": [
    {
      "name": "south-st-pete-api",
      "image": "__IMAGE__",
      "essential": true,
      "command": ["sh", "-c", "uvicorn app.api.main:app --host 0.0.0.0 --port 8000"],
      "portMappings": [{"containerPort": 8000, "protocol": "tcp"}],
      "environment": [
        {"name": "LOCAL_DB_HOST", "value": "__DB_HOST__"},
        {"name": "LOCAL_DB_USER", "value": "app_runtime"},
        {"name": "LOCAL_DB_PASSWORD", "value": "__APP_RUNTIME_DB_PASSWORD__"},
        {"name": "LOCAL_DB_NAME", "value": "southstpete"},
        {"name": "LOCAL_DB_PORT", "value": "5432"},
        {"name": "OPENAI_API_KEY", "value": "__OPENAI_API_KEY__"},
        {"name": "COGNITO_REGION", "value": "__COGNITO_REGION__"},
        {"name": "COGNITO_USER_POOL_ID", "value": "__COGNITO_USER_POOL_ID__"},
        {"name": "COGNITO_APP_CLIENT_ID", "value": "__COGNITO_APP_CLIENT_ID__"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/south-st-pete-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "api",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "cloudflared",
      "image": "__CLOUDFLARED_IMAGE__",
      "essential": true,
      "command": ["tunnel", "--metrics", "127.0.0.1:20241", "run"],
      "secrets": [{"name": "TUNNEL_TOKEN", "valueFrom": "__TUNNEL_TOKEN_SECRET_ARN__"}],
      "dependsOn": [{"containerName": "south-st-pete-api", "condition": "START"}],
      "memoryReservation": 64,
      "healthCheck": {
        "command": ["CMD", "cloudflared", "tunnel", "--metrics", "127.0.0.1:20241", "ready"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/south-st-pete-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "cloudflared",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
