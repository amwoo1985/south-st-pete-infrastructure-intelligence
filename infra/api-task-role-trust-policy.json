{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "ecs-tasks.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "__ACCOUNT_ID__" },
        "ArnLike": { "aws:SourceArn": "arn:aws:ecs:us-east-1:__ACCOUNT_ID__:*" }
      }
    }
  ]
}
