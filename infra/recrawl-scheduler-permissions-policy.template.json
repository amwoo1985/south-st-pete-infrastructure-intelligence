{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RunRecrawlMigrateTask",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "__TASKDEF_FAMILY_ARN__",
      "Condition": {
        "ArnEquals": { "ecs:cluster": "__CLUSTER_ARN__" }
      }
    },
    {
      "Sid": "PassTaskExecutionRoleToECS",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "__TASK_EXEC_ROLE_ARN__",
      "Condition": {
        "StringLike": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
