{
  "family": "south-st-pete-migrate",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::__ACCOUNT_ID__:role/south-st-pete-ecs-task-execution-role",
  "containerDefinitions": [
    {
      "name": "south-st-pete-migrate",
      "image": "__IMAGE__",
      "essential": true,
      "command": ["python", "-m", "app.db.migrate", "status"],
      "environment": [
        {"name": "LOCAL_DB_HOST", "value": "__DB_HOST__"},
        {"name": "LOCAL_DB_NAME", "value": "southstpete"},
        {"name": "LOCAL_DB_PORT", "value": "5432"},
        {"name": "MIGRATION_DB_USER", "value": "__RDS_MASTER_USERNAME__"},
        {"name": "MIGRATION_DB_PASSWORD", "value": "__RDS_MASTER_PASSWORD__"},
        {"name": "APP_RUNTIME_DB_PASSWORD", "value": "__APP_RUNTIME_DB_PASSWORD__"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/south-st-pete-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "migrate",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
